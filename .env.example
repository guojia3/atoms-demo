# ============ 运行 ============
PORT=3000
# SQLite 数据文件路径（部署时挂载卷到 /data）
DATABASE_PATH=./data/atoms.db
# 1 = 强制演示模式（不调用任何模型，使用内置模板，保证无 Key 也能完整演示）
MOCK_MODE=0
# 浏览器实测最长等待时间（毫秒），超时后按服务端启发式评分继续收尾
PROBE_TIMEOUT_MS=15000
# 候选数量：2 = 双路赛马（默认，并行生成后择优采用），1 = 单路生成
RACE_COUNT=2
# 请求体上限（超过返回 413）
BODY_LIMIT=1mb
# 每用户每小时生成次数上限（创建/编辑/修复/重试都计入；超限返回 429 + Retry-After）
GENERATION_RATE_LIMIT=20
# 额外允许的前端来源（逗号分隔，如 https://app.example.com）；同源始终放行
PUBLIC_ORIGIN=

# ============ 模型（OpenAI 兼容 /chat/completions） ============
# 单供应商最小配置（DeepSeek 示例）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODELS=deepseek-chat

# 多供应商配置（可选，JSON；数组里第一个为主，失败自动切下一个）
# LLM_PROVIDERS=[{"name":"deepseek","baseUrl":"https://api.deepseek.com/v1","apiKey":"","model":"deepseek-chat"},{"name":"qwen","baseUrl":"https://dashscope.aliyuncs.com/compatible-mode/v1","apiKey":"","model":"qwen-plus"}]

# ============ 部署 ============
# 用于 /api/health 展示，可填 git commit
GIT_COMMIT=
